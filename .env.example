# Copia in .env sul server. Non committare mai il file vero.

# Obbligatoria. Cifra i secret TOTP e la password SMTP, e firma i token CSRF.
# Genera una volta sola con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se la perdi: i secret TOTP diventano illeggibili (gli utenti riattivano il
# secondo fattore) e la password SMTP va reinserita. Le password degli utenti
# non sono toccate, perché sono hash bcrypt e non passano di qui.
FERNET_KEY=

# Il cookie deve stare sul dominio padre, altrimenti il gate non lo vede in una
# richiesta diretta a lssr.borant.eu. È anche il motivo per cui ogni blocco
# Caddy deve rimuovere borant_session prima di girare la richiesta all'app
# (SPEC.md §14).
COOKIE_DOMAIN=.borant.eu

# Mettere a 0 solo per lo sviluppo locale su http.
COOKIE_SECURE=1

# ORCID: client pubblico gratuito, registrato in orcid.org > Developer Tools.
# Redirect URI da dichiarare lì: https://id.borant.eu/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_SANDBOX=0

# Lo SMTP NON sta qui: si configura da /admin/config, perché la casella non si
# conosce al momento del deploy (SPEC.md §5).
